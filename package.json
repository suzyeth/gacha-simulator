{
  "name": "gacha-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --force",
    "build": "tsc -b --force && vite build",
    "lint": "eslint .",
